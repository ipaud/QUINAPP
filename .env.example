# ── QUINAPP · variables d'entorn ──────────────────────────────────────────────
# Copia aquest fitxer a `.env` (o exporta'l a la shell) i omple els valors.
# Cap és obligatori per a un ús local bàsic, però sí recomanat en LAN/producció.

# Port i host del servidor embegut (Electron força HOST=0.0.0.0 i PORT=3000).
PORT=3000
HOST=127.0.0.1

# HTTPS amb cert autosignat (perquè la càmera del mòbil funcioni a l'escàner).
# Per defecte actiu al port 3443. Desactiva amb QUINAPP_HTTPS=0.
HTTPS_PORT=3443
QUINAPP_HTTPS=1

# URL pública usada als QR (ideal per LAN; p.ex. http://192.168.1.50:3000).
# Si no es defineix, s'autodetecta la IP local.
PUBLIC_BASE_URL=

# Secret HMAC per signar els QR de validació.
# Si no es defineix, se'n genera un d'aleatori i es persisteix a data/qr-secret.key.
# OBLIGATORI si NODE_ENV=production.
QR_HMAC_SECRET=

# Caducitat dels QR en dies (per defecte 30).
QR_TTL_DAYS=30

# Client ID de l'app de Spotify (login PKCE des de la UI). Opcional.
SPOTIFY_CLIENT_ID=

# Directori de dades (SQLite + secret). Per defecte ./data (o userData a Electron).
QUINAPP_DATA_DIR=

# production exigeix QR_HMAC_SECRET i desactiva fallbacks de desenvolupament.
NODE_ENV=
