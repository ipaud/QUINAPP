{
  "name": "quinapp-v3-phased",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs",
    "start:desktop": "npm run electron:dev",
    "app:macos": "bash scripts/make-macos-app.sh",
    "serve": "node apps/api/src/server.mjs",
    "test:unit": "node tests/unit.mjs",
    "test:integration": "node tests/integration.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "electron:dev": "env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:pack:mac": "env -u ELECTRON_RUN_AS_NODE electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "^12.9.0",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.quinapp.desktop",
    "productName": "QUINAPP",
    "files": [
      "apps/**/*",
      "packages/**/*",
      "scripts/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "README.md"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.icns"
    }
  }
}
